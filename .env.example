# Optional path to a YAML configuration file. Relative paths use the current directory.
AEGISHUNT_CONFIG=configs/application.yaml

# Environment variables override YAML values. Nested keys use a double underscore.
AEGISHUNT_APPLICATION__ENVIRONMENT=development
AEGISHUNT_DATABASE__URL=sqlite:///data/aegishunt.db
AEGISHUNT_DATABASE__ECHO=false
AEGISHUNT_DATABASE__BUSY_TIMEOUT_MS=5000

# Telemetry upload policy and controlled local roots.
AEGISHUNT_INGESTION__STORAGE_ROOT=data/raw
AEGISHUNT_INGESTION__SAMPLE_ROOT=data/sample
AEGISHUNT_INGESTION__MAX_UPLOAD_BYTES=52428800
AEGISHUNT_INGESTION__CHUNK_SIZE_BYTES=65536
AEGISHUNT_INGESTION__MAX_RECORDS=100000
AEGISHUNT_FLOWS__IDLE_TIMEOUT_SECONDS=60.0
AEGISHUNT_FLOWS__ACTIVE_TIMEOUT_SECONDS=300.0
AEGISHUNT_FLOWS__MAX_PACKETS_PER_FLOW=10000
AEGISHUNT_FLOWS__MAX_ACTIVE_FLOWS=100000
AEGISHUNT_FLOWS__MAX_PACKET_BYTES=262144

# Dataset definitions, local artifact roots, safety limits, and reproducible splits.
AEGISHUNT_DATASETS__REGISTRY_PATH=configs/datasets/registry.yaml
AEGISHUNT_DATASETS__LABEL_MAPPING_ROOT=configs/label_mappings
AEGISHUNT_DATASETS__RAW_ROOT=data/raw/datasets
AEGISHUNT_DATASETS__INTERIM_ROOT=data/interim/datasets
AEGISHUNT_DATASETS__PROCESSED_ROOT=data/processed/datasets
AEGISHUNT_DATASETS__REPORTS_ROOT=reports/datasets
AEGISHUNT_DATASETS__MAX_DOWNLOAD_BYTES=10737418240
AEGISHUNT_DATASETS__MAX_ARCHIVE_MEMBERS=10000
AEGISHUNT_DATASETS__MAX_EXTRACTED_BYTES=21474836480
AEGISHUNT_DATASETS__NEAR_DUPLICATE_TOLERANCE=0.000001
AEGISHUNT_DATASETS__DEMO_SEED=4204
AEGISHUNT_DATASETS__TRAIN_RATIO=0.6
AEGISHUNT_DATASETS__VALIDATION_RATIO=0.2
AEGISHUNT_DATASETS__TEST_RATIO=0.2

# Supervised training policy and ignored experiment/model roots.
AEGISHUNT_SUPERVISED__TRAINING_CONFIG_PATH=configs/models/supervised.yaml
AEGISHUNT_SUPERVISED__ARTIFACT_ROOT=artifacts/models/supervised
AEGISHUNT_SUPERVISED__REPORTS_ROOT=reports/models/supervised
